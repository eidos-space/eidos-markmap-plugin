    "build": "npm run pack:plugin"
  },
  "dependencies": {
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12"
  },
  "devDependencies": {
    "@eidos.space/plugin-sdk": "0.5.0",
    "@eidos.space/plugin-tools": "0.5.0",
    "esbuild": "0.28.1",
    "typescript": "5.8.3"
  }
}
