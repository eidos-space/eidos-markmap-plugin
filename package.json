{
  "name": "@eidos.space/plugin-markmap",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Interactive Markmap mindmap plugin for Markdown files in Eidos Lite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/prepare-view.mjs && eidos-plugin check .",
